# Hardened Sudoers Policy for Autonomous Agent Sandbox
# Positive allowlist: only specific monitoring and package management commands are permitted
agentuser ALL=(ALL) NOPASSWD: \
    /usr/bin/systemctl is-active *, \
    /usr/bin/systemctl status *, \
    /usr/bin/dmesg, \
    /usr/bin/journalctl, \
    /usr/bin/apt-get update, \
    /usr/bin/apt-get install -y *

# Explicitly forbidden commands (defense-in-depth deny list)
agentuser ALL=(ALL) !/usr/bin/systemd-run, \
    !/usr/bin/nsenter, \
    !/usr/bin/chroot, \
    !/usr/bin/unshare, \
    !/usr/bin/bash, \
    !/usr/bin/sh, \
    !/usr/bin/su, \
    !/usr/bin/tee
